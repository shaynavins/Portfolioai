# PortfolioAI — Production Environment Variables
# Copy this file to .env and fill in actual values
# NEVER commit .env to git — it contains secrets!

# ═══════════════════════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════════════════════
ENVIRONMENT=development                    # development, staging, production
APP_URL=http://localhost:3000              # Frontend URL (no trailing slash)
API_URL=http://localhost:8000              # Backend API URL (no trailing slash)
PORTFOLIO_BASE_DOMAIN=portfolioai.app       # Custom domain suffix
DEBUG=false                                 # Enable debug mode (dev only)

# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY & JWT
# ═══════════════════════════════════════════════════════════════════════════════
JWT_SECRET=your-secret-key-change-in-prod  # CRITICAL: 32+ random chars in production
JWT_ALGORITHM=HS256                         # Signing algorithm
JWT_ACCESS_EXPIRE_MINUTES=15                # Access token lifetime (minutes)
JWT_REFRESH_EXPIRE_DAYS=30                  # Refresh token lifetime (days)

REQUIRE_HTTPS=false                         # Enforce HTTPS in production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000  # CORS origins

# ═══════════════════════════════════════════════════════════════════════════════
# GITHUB OAUTH
# ═══════════════════════════════════════════════════════════════════════════════
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE (PostgreSQL)
# ═══════════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@localhost:5432/portfolioai
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# For production, use: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false                         # Log SQL statements (dev only)

# ═══════════════════════════════════════════════════════════════════════════════
# REDIS/CACHE (for rate limiting, session cache)
# ═══════════════════════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# ═══════════════════════════════════════════════════════════════════════════════
# CELERY/JOB QUEUE
# ═══════════════════════════════════════════════════════════════════════════════
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIMEOUT=600

# ═══════════════════════════════════════════════════════════════════════════════
# AI/GEMINI (Portfolio generation)
# ═══════════════════════════════════════════════════════════════════════════════
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash

# Google OAuth for Google Docs resume sync
# Authorized redirect URI: http://localhost:8000/api/google/callback
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# ═══════════════════════════════════════════════════════════════════════════════
# OBJECT STORAGE (Cloudflare R2 — S3-compatible)
# ═══════════════════════════════════════════════════════════════════════════════
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=portfolioai-sites
R2_PUBLIC_URL=https://portfolioai-r2.example.com

# ═══════════════════════════════════════════════════════════════════════════════
# VERCEL DEPLOYMENT (for hosting generated portfolio sites)
# ═══════════════════════════════════════════════════════════════════════════════
VERCEL_TOKEN=your-vercel-api-token
VERCEL_TEAM_ID=your-vercel-team-id

# ═══════════════════════════════════════════════════════════════════════════════
# STRIPE (Payment processing)
# ═══════════════════════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=sk_test_xxxxx              # Stripe secret key (test or live)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx         # Stripe publishable key
STRIPE_WEBHOOK_SECRET=whsec_xxxxx            # Stripe webhook signing secret
STRIPE_PRODUCT_ID_PRO=price_xxxxx            # Price ID for Pro plan ($9/mo)
STRIPE_PRODUCT_ID_TEAM=price_xxxxx           # Price ID for Team plan ($29/mo)

# ═══════════════════════════════════════════════════════════════════════════════
# SENDGRID (Transactional email)
# ═══════════════════════════════════════════════════════════════════════════════
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx             # SendGrid API key
SENDGRID_FROM_EMAIL=noreply@portfolioai.app   # Sender email address
SENDGRID_FROM_NAME=PortfolioAI                # Sender display name

# ═══════════════════════════════════════════════════════════════════════════════
# MONITORING & ERROR TRACKING (optional)
# ═══════════════════════════════════════════════════════════════════════════════
SENTRY_DSN=https://key@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# ═══════════════════════════════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO                               # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json                              # json or text

# ═══════════════════════════════════════════════════════════════════════════════
# FEATURE FLAGS (Phase 3+)
# ═══════════════════════════════════════════════════════════════════════════════
FEATURE_EMAIL_NOTIFICATIONS=true             # Enable SendGrid emails
FEATURE_WEBHOOKS=true                        # Enable GitHub/user webhooks
FEATURE_ANALYTICS=false                      # Analytics dashboard (Phase 4)
FEATURE_WHITE_LABEL=false                    # White-label support (Phase 4)

# ═══════════════════════════════════════════════════════════════════════════════
# TIER LIMITS
# ═══════════════════════════════════════════════════════════════════════════════
PORTFOLIO_LIMIT_FREE=1                       # Max portfolios per free user
PORTFOLIO_LIMIT_PRO=10
PORTFOLIO_LIMIT_TEAM=100

UPDATE_CADENCE_FREE_HOURS=24                 # Auto-update frequency (free = daily)
UPDATE_CADENCE_PRO_HOURS=0                   # Pro = real-time (0 = disabled)
UPDATE_CADENCE_TEAM_HOURS=0

CUSTOM_DOMAIN_ENABLED_FREE=false             # Custom domain support per tier
CUSTOM_DOMAIN_ENABLED_PRO=true
CUSTOM_DOMAIN_ENABLED_TEAM=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_FREE_TIER=100                     # Requests per minute
RATE_LIMIT_PRO_TIER=500
RATE_LIMIT_TEAM_TIER=0                       # 0 = unlimited
