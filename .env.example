# ============================================================
# PortfolioAI — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FAST_MODEL=gpt-4.1-mini

# --- GitHub OAuth App ---
# Create at: https://github.com/settings/applications/new
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- JWT Secret (generate: openssl rand -hex 32) ---
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Database (PostgreSQL) ---
# Local: postgresql://postgres:password@127.0.0.1:5432/portfolioai
# Production: use Supabase free tier connection string
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/portfolioai

# --- Redis (job queue) ---
# Local: redis://localhost:6379
# Production: Upstash Redis URL
REDIS_URL=redis://127.0.0.1:6379

# --- Cloudflare R2 (generated site storage) ---
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=portfolioai-sites
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# --- Vercel (portfolio deployment) ---
VERCEL_TOKEN=your_vercel_token
VERCEL_TEAM_ID=  # optional, for team accounts

# --- App Config ---
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
PORTFOLIO_BASE_DOMAIN=portfolioai.app  # change to your domain
ENVIRONMENT=development  # development | production

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id
