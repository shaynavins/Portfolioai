# ============================================================
# PortfolioAI — Environment Variables (Production-Grade)
# Copy to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development  # development | staging | production
DEBUG=false
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
PORTFOLIO_BASE_DOMAIN=portfolioai.app

# ─── Security & Secrets ───────────────────────────────────────────────────────
# Generate JWT secret: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_change_me_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# CORS & HTTPS
REQUIRE_HTTPS=false  # Set to true in production
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FREE_TIER=100
RATE_LIMIT_PRO_TIER=500
RATE_LIMIT_TEAM_TIER=0

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create app: https://github.com/settings/applications/new
# Authorization callback URL: https://api.portfolioai.app/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret_for_verification

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local: postgresql+asyncpg://postgres:password@127.0.0.1/portfolioai
# Production: postgresql+asyncpg://user:pass@host:5432/portfolioai
# Supabase: postgresql+asyncpg://postgres.xxxxx:password@db.xxxxx.supabase.co/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1/portfolioai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ─── Redis / Cache ────────────────────────────────────────────────────────────
# Local: redis://127.0.0.1:6379
# Production: Upstash or AWS ElastiCache
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_POOL_SIZE=10

# ─── Celery / Job Queue ───────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_TIMEOUT=600

# ─── AI / Google Gemini ───────────────────────────────────────────────────────
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash

# ─── Object Storage (Cloudflare R2) ───────────────────────────────────────────
# Sign up: https://dash.cloudflare.com/
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=portfolioai-sites
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# ─── Vercel (Portfolio Deployment) ────────────────────────────────────────────
# Token: https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token
VERCEL_TEAM_ID=

# ─── Stripe / Payments (Phase 2) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRODUCT_ID_PRO=prod_...
STRIPE_PRODUCT_ID_TEAM=prod_...

# ─── Email / SendGrid (Phase 3) ───────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@portfolioai.app
SENDGRID_FROM_NAME=PortfolioAI

# ─── Monitoring / Sentry (Phase 4) ────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Tier-based Limits ────────────────────────────────────────────────────────
PORTFOLIO_LIMIT_FREE=1
PORTFOLIO_LIMIT_PRO=10
PORTFOLIO_LIMIT_TEAM=100
UPDATE_CADENCE_FREE_HOURS=24
UPDATE_CADENCE_PRO_HOURS=0
UPDATE_CADENCE_TEAM_HOURS=0
CUSTOM_DOMAIN_ENABLED_FREE=false
CUSTOM_DOMAIN_ENABLED_PRO=true
CUSTOM_DOMAIN_ENABLED_TEAM=true

# ─── Feature Flags ────────────────────────────────────────────────────────────
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_WEBHOOKS=true
FEATURE_ANALYTICS=false
FEATURE_WHITE_LABEL=false

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...
