# PortfolioAI India — Production Environment Variables
# For ₹200/month single-tier SaaS with Razorpay
# Copy to .env and update with your own credentials

# ═══════════════════════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════════════════════
ENVIRONMENT=production
APP_URL=https://portfolioai.in
API_URL=https://api.portfolioai.in
PORTFOLIO_BASE_DOMAIN=portfolioai.in
DEBUG=false

# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY & JWT
# ═══════════════════════════════════════════════════════════════════════════════
JWT_SECRET=your-super-secret-32-char-random-string-change-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
REQUIRE_HTTPS=true
ALLOWED_ORIGINS=https://portfolioai.in,https://www.portfolioai.in

# ═══════════════════════════════════════════════════════════════════════════════
# GITHUB OAUTH (for signup/login)
# ═══════════════════════════════════════════════════════════════════════════════
GITHUB_CLIENT_ID=Ov23liykkjykXAzGjsmr
GITHUB_CLIENT_SECRET=2400ffad5623a321d98993046a0c4514514c4515
GITHUB_WEBHOOK_SECRET=your-random-webhook-secret

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE (PostgreSQL)
# ═══════════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql+asyncpg://user:password@db.example.com:5432/portfolioai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ═══════════════════════════════════════════════════════════════════════════════
# REDIS (for rate limiting, caching)
# ═══════════════════════════════════════════════════════════════════════════════
REDIS_URL=redis://cache.example.com:6379/0
REDIS_POOL_SIZE=10

# ═══════════════════════════════════════════════════════════════════════════════
# GOOGLE GEMINI (for AI portfolio generation)
# ═══════════════════════════════════════════════════════════════════════════════
GOOGLE_API_KEY=AIzaSyDTIFGxPHajGfqgWomYUtm6Sk0h_WZ3pWw
GEMINI_MODEL=gemini-2.5-flash

# ═══════════════════════════════════════════════════════════════════════════════
# RAZORPAY (India payment processor - ₹200/month)
# ═══════════════════════════════════════════════════════════════════════════════
RAZORPAY_KEY_ID=rzp_test_SrUrKdxyZyDClk
RAZORPAY_KEY_SECRET=wpPh8hZTz9yZo0hVUfOy8sNe
RAZORPAY_PLAN_ID=plan_xxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxx

# ═══════════════════════════════════════════════════════════════════════════════
# SENDGRID (Transactional email)
# ═══════════════════════════════════════════════════════════════════════════════
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@portfolioai.in
SENDGRID_FROM_NAME=PortfolioAI

# ═══════════════════════════════════════════════════════════════════════════════
# CLOUDFLARE R2 (Object storage for portfolio sites)
# ═══════════════════════════════════════════════════════════════════════════════
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=portfolioai-sites
R2_PUBLIC_URL=https://cdn.portfolioai.in

# ═══════════════════════════════════════════════════════════════════════════════
# LOGGING & MONITORING
# ═══════════════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
LOG_FORMAT=json

# ═══════════════════════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════════════════════
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_WEBHOOKS=true
FEATURE_ANALYTICS=false
